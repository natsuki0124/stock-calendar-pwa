{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stock-calendar-pwa",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "us-stock-db",
      "database_id": "f0e4f9a7-39aa-4c43-81f2-31ddc11f1b90"
    }
  ],
  "triggers": {
    "crons": ["0 21 * * *"]
  }
}